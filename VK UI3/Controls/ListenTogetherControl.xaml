<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VK_UI3.Controls.ListenTogetherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VK_UI3.ViewModels.Controls"
    xmlns:local="using:VK_UI3.Controls"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="300"
    FontFamily="{StaticResource VKSansDemiBold}">

    <UserControl.Resources>
        <Style x:Key="ListenTogetherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontFamily" Value="{StaticResource VKSansDemiBold}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Состояние: подключено — видно только когда IsConnected = true -->
        <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed">
            <StackPanel Visibility="{x:Bind ViewModel.IsSessionHost, Mode=OneWay}">
                <TextBlock
                    Text="С вами слушают"
                    FontFamily="{StaticResource VKSansDemiBold}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:ListenTogetherSession">
                            <Border
                                BorderThickness="2"
                                BorderBrush="White"
                                CornerRadius="20"
                                Margin="-8,0,0,0"
                                Width="40"
                                Height="40">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{x:Bind Name}" />
                                </ToolTipService.ToolTip>
                                <Ellipse Width="36" Height="36">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{x:Bind AvatarUrl}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button
                Style="{StaticResource ListenTogetherButtonStyle}"
                Content="Ссылка на сессию"
                Visibility="{x:Bind ViewModel.IsSessionHost, Mode=OneWay}"
                Click="OpenLinkButton_Click" />

            <!-- Кнопка завершения сессии — видна всегда когда подключены -->
            <Button
                Style="{StaticResource ListenTogetherButtonStyle}"
                Content="{x:Bind local:ListenTogetherControl.GetStopButtonText(ViewModel.IsSessionHost), Mode=OneWay}"
                Click="StopButton_Click" />
        </StackPanel>

        <!-- Состояние: не подключено — видно только когда IsConnected = false -->
        <StackPanel x:Name="DisconnectedPanel" Visibility="Visible">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                Width="24"
                Height="24"
                Margin="0,8" />

            <StackPanel Visibility="{x:Bind local:ListenTogetherControl.InvertVisibility(ViewModel.IsLoading), Mode=OneWay}">
                <TextBlock
                    Text="Совместное прослушивание"
                    FontFamily="{StaticResource VKSansDemiBold}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <SymbolIcon Symbol="DisconnectDrive" />
                    <TextBlock Text="Не подключено" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource VKSansDemiBold}" />
                </StackPanel>

                <Button
                    Style="{StaticResource ListenTogetherButtonStyle}"
                    Content="Создать сессию"
                    Click="StartSessionButton_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBox
                        x:Name="SessionIdBox"
                        PlaceholderText="ID сессии"
                        Width="180"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource VKSansDemiBold}" />
                    <Button
                        Margin="8,0,0,0"
                        Height="32"
                        Width="40"
                        Click="ConnectButton_Click">
                        <SymbolIcon Symbol="Play" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Уведомления внутри контрола (вместо ContentDialog) -->
        <Border
            x:Name="NotificationBorder"
            Visibility="Collapsed"
            Background="{ThemeResource SystemAccentColor}"
            CornerRadius="6"
            Padding="8"
            Margin="0,4"
            HorizontalAlignment="Stretch">
            <TextBlock
                x:Name="NotificationText"
                TextWrapping="WrapWholeWords"
                FontSize="11"
                Foreground="White"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource VKSansDemiBold}" />
        </Border>
    </Grid>
</UserControl>