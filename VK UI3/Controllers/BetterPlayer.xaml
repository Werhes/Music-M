<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VK_UI3.Controllers.BetterPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constrols="using:VK_UI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="pageRa"
    AutomationProperties.Name="BetterPlayer"
    AutomationProperties.HelpText="Альфа-плеер в стиле MusicX">

    <Grid Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid.ContextFlyout>
            <constrols:AudioControlFlyOut x:Name="FlyOutControl" />
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Прогресс  -->
        <Grid Grid.Row="0" Padding="18,6,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" Text="0:00" />
            <Slider
                x:Name="ProgressSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="1"
                StepFrequency="0.01"
                VerticalAlignment="Center"
                ValueChanged="ProgressSlider_ValueChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Text="0:00" />
        </Grid>

        <!--  Основная панель  -->
        <Grid Grid.Row="1" Padding="18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Левая часть: обложка + информация + лайк/дизлайк/текст  -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Grid
                    Width="54"
                    Height="54"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    Tapped="Cover_Tapped">
                    <FontIcon FontSize="22" Glyph="&#xEC4F;" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Grid>

                <StackPanel VerticalAlignment="Center" Spacing="3" MaxWidth="250">
                    <TextBlock
                        x:Name="TitleText"
                        Text="Название трека"
                        FontWeight="SemiBold"
                        FontSize="15"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        Tapped="Title_Tapped" />
                    <TextBlock
                        x:Name="ArtistText"
                        Text="Исполнитель"
                        Opacity="0.7"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        Tapped="Artist_Tapped" />
                </StackPanel>

                <Button x:Name="LikeBtn" Width="38" Height="38" Background="Transparent" BorderThickness="0" Padding="0" Click="LikeBtn_Click" AutomationProperties.Name="Добавить в библиотеку">
                    <Grid Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <PathIcon x:Name="LikeIconOutline" Width="16" Height="16" Data="M16.5,3 C14.76,3 13.09,3.81 12,5.09 C10.91,3.81 9.24,3 7.5,3 C4.42,3 2,5.42 2,8.5 C2,12.28 5.4,15.36 10.55,20.03 L12,21.35 L13.45,20.03 C18.6,15.36 22,12.28 22,8.5 C22,5.42 19.58,3 16.5,3 Z M12.1,18.55 L12,18.65 L11.9,18.55 C7.14,14.24 4,11.39 4,8.5 C4,6.5 5.5,5 7.5,5 C9.04,5 10.54,5.99 11.07,7.36 L12.93,7.36 C13.46,5.99 14.96,5 16.5,5 C18.5,5 20,6.5 20,8.5 C20,11.39 16.86,14.24 12.1,18.55 Z" />
                        <PathIcon x:Name="LikeIconFill" Width="16" Height="16" Visibility="Collapsed" Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.03 L12,21.35 Z" />
                    </Grid>
                </Button>
                <Button x:Name="LyricsBtn" Width="38" Height="38" Background="Transparent" BorderThickness="0" Padding="0" Click="LyricsBtn_Click" AutomationProperties.Name="Текст песни">
                    <TextBlock FontWeight="Bold" Text="Тт" />
                </Button>
                <Button x:Name="DownloadBtn" Width="38" Height="38" Background="Transparent" BorderThickness="0" Padding="0" Click="DownloadBtn_Click" AutomationProperties.Name="Скачать трек">
                    <FontIcon FontSize="16" Glyph="&#xE118;" />
                </Button>
            </StackPanel>

            <!--  Центральная часть: транспорт  -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <Button x:Name="ShuffleBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="ShuffleBtn_Click" AutomationProperties.Name="Перемешать">
                    <FontIcon x:Name="ShuffleIcon" FontSize="14" Glyph="&#xE8B1;" />
                </Button>
                <Button x:Name="PrevBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="PrevBtn_Click" AutomationProperties.Name="Предыдущий трек">
                    <FontIcon FontSize="14" Glyph="&#xE100;" />
                </Button>
                <Button x:Name="PlayPauseBtn" Width="44" Height="44" Background="Transparent" BorderThickness="0" Click="PlayPauseBtn_Click" AutomationProperties.Name="Воспроизвести/Пауза">
                    <FontIcon x:Name="PlayPauseIcon" FontSize="20" Glyph="&#xE102;" />
                </Button>
                <Button x:Name="NextBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="NextBtn_Click" AutomationProperties.Name="Следующий трек">
                    <FontIcon FontSize="14" Glyph="&#xE101;" />
                </Button>
                <Button x:Name="RepeatBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="RepeatBtn_Click" AutomationProperties.Name="Повтор">
                    <FontIcon x:Name="RepeatIcon" FontSize="14" Glyph="&#xE8EE;" />
                </Button>
            </StackPanel>

            <!--  Правая часть: действия  -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <Button x:Name="VolumeBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Громкость">
                    <SymbolIcon Symbol="Volume" />
                    <Button.Flyout>
                        <Flyout>
                            <Slider x:Name="VolumeSlider" Width="150" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="VolumeSlider_ValueChanged" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="QueueBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="QueueBtn_Click" AutomationProperties.Name="Список воспроизведения">
                    <SymbolIcon Symbol="List" />
                </Button>
                <Button x:Name="FullScreenBtn" Width="36" Height="36" Margin="2,0,0,0" Background="Transparent" BorderThickness="0" Click="FullScreenBtn_Click" AutomationProperties.Name="Полноэкранный плеер">
                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>