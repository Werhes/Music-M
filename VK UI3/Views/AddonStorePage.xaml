<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VK_UI3.Views.AddonStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.Name="Магазин дополнений"
    AutomationProperties.HelpText="Страница для загрузки и установки дополнений и тем">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель с заголовком -->
        <Grid Grid.Row="0" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Text="Магазин дополнений" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                MinWidth="40"
                Height="32"
                VerticalAlignment="Center"
                Click="OnRefreshClick"
                AutomationProperties.Name="Обновить">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!-- Табы: Магазин | Установленные аддоны | Установленные темы -->
        <NavigationView
            x:Name="TabNav"
            Grid.Row="1"
            Margin="12,8,12,0"
            PaneDisplayMode="Top"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            AlwaysShowHeader="False"
            SelectionChanged="OnTabSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="StoreTab"
                    Icon="Shop"
                    Content="Магазин"
                    Tag="store" />
                <NavigationViewItem
                    x:Name="InstalledAddonsTab"
                    Icon="Library"
                    Content="Установленные аддоны"
                    Tag="installedAddons" />
                <NavigationViewItem
                    x:Name="InstalledThemesTab"
                    Icon="Paint"
                    Content="Установленные темы"
                    Tag="installedThemes" />
            </NavigationView.MenuItems>
        </NavigationView>

        <!-- Индикатор загрузки -->
        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="2"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <!-- Контентная область -->
        <ScrollViewer
            x:Name="ContentScroll"
            Grid.Row="2"
            Margin="12,8,12,12"
            Visibility="Visible">
            <ItemsControl x:Name="ItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            MaximumRowsOrColumns="4"
                            ItemWidth="300"
                            ItemHeight="180" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="10"
                            Padding="14"
                            Margin="6"
                            Width="288"
                            Height="168">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Иконка -->
                                <Border
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Width="56"
                                    Height="56"
                                    Margin="0,0,12,0"
                                    CornerRadius="8"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image
                                        Width="56"
                                        Height="56"
                                        Stretch="UniformToFill"
                                        Source="{Binding Icon}"
                                        AutomationProperties.Name="Иконка" />
                                </Border>

                                <!-- Название -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />

                                <!-- Автор и версия -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Author}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Version}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Нижняя панель с кнопками -->
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                                    <!-- Основная кнопка действия -->
                                    <Button
                                        x:Name="ActionButton"
                                        MinWidth="90"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="11"
                                        Content="{Binding ButtonText}"
                                        Tag="{Binding}"
                                        Click="OnActionButtonClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Сообщение об ошибке/пусто -->
        <TextBlock
            x:Name="EmptyMessage"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Нет доступных элементов."
            Visibility="Collapsed"
            TextWrapping="Wrap" />
    </Grid>
</Page>