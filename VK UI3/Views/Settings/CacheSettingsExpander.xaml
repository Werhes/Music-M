<?xml version="1.0" encoding="utf-8" ?>
<Expander
    x:Class="VK_UI3.Views.Settings.CacheSettingsExpander"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Views.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    IsExpanded="False"
    mc:Ignorable="d">

    <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE8D5;" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Настройки кеширования" />
        </StackPanel>
    </Expander.Header>

    <Expander.Content>
        <StackPanel Spacing="12" HorizontalAlignment="Stretch">

            <!--  Кеш изображений  -->
            <Border Padding="12" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="Кеш изображений"
                        AutomationProperties.Name="Заголовок кеша изображений"
                        AutomationProperties.HelpText="Настройки кеширования изображений на диске" />

                    <local:ImageCacheEnabledSetting
                        AutomationProperties.Name="Включить кеширование изображений"
                        AutomationProperties.HelpText="Включает или выключает кеширование изображений на диске" />

                    <StackPanel>
                        <TextBlock
                            AutomationProperties.Name="Максимум одновременных загрузок"
                            AutomationProperties.HelpText="Максимальное количество одновременно загружаемых изображений"
                            Text="Максимум одновременных загрузок" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MaxConcurrentDownloadsSetting
                                x:Name="maxDownloads"
                                Grid.Column="0"
                                AutomationProperties.Name="Ползунок макс. загрузок"
                                AutomationProperties.HelpText="Регулирует количество одновременных загрузок" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Значение макс. загрузок"
                                AutomationProperties.HelpText="Текущее значение"
                                Text="{x:Bind maxDownloads.Value, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <local:EnableDownloadQueueSetting
                        AutomationProperties.Name="Очередь загрузки"
                        AutomationProperties.HelpText="Включает или выключает очередь загрузки изображений" />

                    <StackPanel>
                        <TextBlock
                            AutomationProperties.Name="Максимум файлов в кеше"
                            AutomationProperties.HelpText="Максимальное количество файлов в кеше изображений"
                            Text="Максимум файлов в кеше" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:ImageCacheMaxFilesSetting
                                x:Name="maxFiles"
                                Grid.Column="0"
                                AutomationProperties.Name="Ползунок макс. файлов"
                                AutomationProperties.HelpText="Регулирует максимальное количество файлов в кеше" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Значение макс. файлов"
                                AutomationProperties.HelpText="Текущее значение"
                                Text="{x:Bind maxFiles.Value, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <local:AutoClearImageCacheSetting
                        AutomationProperties.Name="Автоочистка кеша"
                        AutomationProperties.HelpText="Автоматически очищать кеш при запуске" />

                    <local:ClearImageCacheButton
                        Margin="0,8,0,0"
                        AutomationProperties.Name="Кнопка очистки кеша"
                        AutomationProperties.HelpText="Очищает весь кеш изображений" />
                </StackPanel>
            </Border>

            <!--  Кеш в памяти  -->
            <Border Padding="12" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="Кеш в памяти"
                        AutomationProperties.Name="Заголовок кеша в памяти"
                        AutomationProperties.HelpText="Настройки кеширования данных в оперативной памяти" />

                    <local:MemoryCacheEnabledSetting
                        AutomationProperties.Name="Включить кеш в памяти"
                        AutomationProperties.HelpText="Включает или выключает кеширование в оперативной памяти" />

                    <StackPanel>
                        <TextBlock
                            AutomationProperties.Name="Время жизни кеша"
                            AutomationProperties.HelpText="Время в минутах, через которое данные в кеше памяти считаются устаревшими"
                            Text="Время жизни кеша (минут)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MemoryCacheTimeLiveSetting
                                x:Name="memoryTimeLive"
                                Grid.Column="0"
                                AutomationProperties.Name="Ползунок времени жизни"
                                AutomationProperties.HelpText="Регулирует время жизни записей в кеше памяти" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Значение времени жизни"
                                AutomationProperties.HelpText="Текущее значение в минутах"
                                Text="{x:Bind memoryTimeLive.Value, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Единицы измерения"
                                AutomationProperties.HelpText="Минуты"
                                Text="мин" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Информация  -->
            <Border
                Padding="12"
                Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                CornerRadius="4">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Информация" />
                    <TextBlock
                        FontSize="12"
                        Text="Изменения настроек кеширования изображений вступают в силу сразу. Настройки кеша в памяти применяются при создании новых экземпляров."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Expander.Content>

    <Expander.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <x:Double x:Key="ExpanderContentThemePadding">12</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Expander.Resources>

</Expander>