<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VK_UI3.Views.FullScreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="fullScreenWnd"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
            <local:LongToDoubleConverter x:Key="LongToDoubleConverter" />
        </Grid.Resources>

        <!-- Жёлтый размытый фон -->
        <Rectangle Fill="#FFD700" Opacity="0.3" />

        <!-- Заголовок "Сейчас играет" -->
        <TextBlock
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="30"
            FontWeight="SemiBold"
            Opacity="0.7"
            Text="Сейчас играет"
            AutomationProperties.Name="Сейчас играет" />

        <!-- Кнопка закрытия (свернуть) -->
        <Button
            x:Name="CloseButton"
            Width="50"
            Height="50"
            Margin="0,20,20,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            Click="CloseButton_Click"
            AutomationProperties.Name="Свернуть полноэкранный плеер">
            <FontIcon
                FontSize="30"
                Glyph="&#xE896;"
                AutomationProperties.Name="Свернуть" />
        </Button>

        <!-- Основной контент -->
        <Grid
            Margin="40,0,0,0"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Обложка -->
            <Grid>
                <Border
                    Width="500"
                    Height="500"
                    Background="#B3000000"
                    CornerRadius="10"
                    AutomationProperties.Name="Тень обложки">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                </Border>
                <Border
                    Width="500"
                    Height="500"
                    CornerRadius="10"
                    AutomationProperties.Name="Обложка альбома">
                    <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"
                        AutomationProperties.Name="Обложка" />
                </Border>
                <FontIcon
                    x:Name="CoverNote"
                    FontSize="460"
                    Glyph="&#xEC4F;"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Иконка ноты" />
            </Grid>

            <!-- Информация о треке и прогресс -->
            <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                <!-- Название трека -->
                <ScrollViewer
                    HorizontalAlignment="Left"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden"
                    MaxWidth="1000"
                    AutomationProperties.Name="Название трека">
                    <TextBlock
                        x:Name="TrackName"
                        FontSize="60"
                        FontWeight="SemiBold"
                        Text="Название трека"
                        TextTrimming="None"
                        TextWrapping="NoWrap"
                        AutomationProperties.Name="Название трека" />
                </ScrollViewer>

                <!-- Исполнитель -->
                <ScrollViewer
                    HorizontalAlignment="Left"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden"
                    MaxWidth="1000"
                    AutomationProperties.Name="Исполнитель">
                    <TextBlock
                        x:Name="ArtistName"
                        FontSize="40"
                        Opacity="0.6"
                        Text="Имя исполнителя"
                        TextTrimming="None"
                        TextWrapping="NoWrap"
                        AutomationProperties.Name="Исполнитель" />
                </ScrollViewer>

                <!-- Прогресс-бар -->
                <Slider
                    x:Name="PositionSlider"
                    Width="400"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Minimum="0"
                    StepFrequency="0.1"
                    ValueChanged="PositionSlider_ValueChanged"
                    AutomationProperties.Name="Прогресс воспроизведения" />
            </StackPanel>

            <!-- Тексты песен (справа) -->
            <Grid Grid.Column="2" Margin="30,0" x:Name="LyricsControlView">
                <!-- Заглушка "нет текста" -->
                <StackPanel
                    x:Name="LyricsPlaceholder"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Visible">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="У этого трека"
                        TextAlignment="Center"
                        AutomationProperties.Name="Нет текста" />
                    <TextBlock
                        FontSize="20"
                        Opacity="0.5"
                        Text="Пока что нет текста"
                        TextAlignment="Center"
                        AutomationProperties.Name="Нет текста" />
                </StackPanel>

                <!-- Текст песни -->
                <ScrollViewer
                    x:Name="LyricsScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Текст песни">
                    <ItemsControl x:Name="LyricsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,4"
                                    FontSize="18"
                                    Text="{Binding}"
                                    TextWrapping="Wrap"
                                    AutomationProperties.Name="Строка текста" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Блок "Далее" -->
        <StackPanel
            Margin="0,0,10,100"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="Следующий трек">
            <TextBlock
                Width="300"
                Margin="0,0,0,10"
                HorizontalAlignment="Right"
                FontSize="18"
                Opacity="0.6"
                Text="Далее"
                AutomationProperties.Name="Далее" />

            <Grid
                x:Name="NextTrackCard"
                Width="300"
                Height="80"
                Padding="10"
                CornerRadius="8"
                Tapped="NextTrackCard_Tapped"
                AutomationProperties.Name="Карточка следующего трека">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Обложка следующего трека -->
                <Grid>
                    <Border
                        Width="50"
                        Height="50"
                        Background="#B3000000"
                        CornerRadius="5"
                        AutomationProperties.Name="Тень обложки" />
                    <Image
                        x:Name="NextTrackCover"
                        Width="50"
                        Height="50"
                        Stretch="UniformToFill"
                        AutomationProperties.Name="Обложка следующего трека" />
                    <FontIcon
                        x:Name="NextTrackNote"
                        FontSize="46"
                        Glyph="&#xEC4F;"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Иконка ноты" />
                </Grid>

                <!-- Информация о следующем треке -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="NextTrackName"
                        Width="185"
                        FontSize="18"
                        Text="Имя трека"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.Name="Название следующего трека" />
                    <TextBlock
                        x:Name="NextTrackArtist"
                        Width="185"
                        FontSize="18"
                        Opacity="0.6"
                        Text="Артист"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.Name="Исполнитель следующего трека" />
                </StackPanel>

                <!-- Иконка "далее" -->
                <FontIcon
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="25"
                    Glyph="&#xE840;"
                    AutomationProperties.Name="Далее" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>